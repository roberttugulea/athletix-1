# Public Supabase client configuration. Never put real values in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Keep its value in the deployment secret store, never in Git.
SUPABASE_SERVICE_ROLE_KEY=

# Email transazionali (Resend). Se assenti, gli invii vengono registrati ma non spediti.
# Crea l'API key su https://resend.com/api-keys. Per iniziare puoi usare il
# mittente sandbox "onboarding@resend.dev"; in produzione verifica un tuo dominio.
RESEND_API_KEY=
EMAIL_FROM="ATHLETIX <onboarding@resend.dev>"

# Job giornaliero (Vercel Cron -> /api/cron/daily, vedi vercel.json). Genera
# un valore casuale lungo (es. `openssl rand -hex 32`) e impostalo identico
# come variabile d'ambiente del progetto Vercel: la richiesta di cron invia
# "Authorization: Bearer <CRON_SECRET>" e la route la verifica.
CRON_SECRET=
